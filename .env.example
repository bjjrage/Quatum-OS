# Server-side only. Never expose to the browser / apps/web.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET_MARKET_DATA=
SUPABASE_STORAGE_BUCKET_RESEARCH=

# ==============================================================================
# Quant OS Execution Plane (v1) Configuration & Placeholders
# ==============================================================================
# Execution mode: PAPER | SHADOW | SANDBOX | LIVE_LOCKED | LIVE (default: LIVE_LOCKED)
# When set to LIVE, live capital remains hard-locked at USD 0 until economic edge is validated.
QUANT_OS_EXECUTION_MODE=

# ------------------------------------------------------------------------------
# PERMISSION POLICY (CRITICAL):
# - Quant OS NEVER requires withdrawal permission.
# - On API key creation: DISABLE withdrawals, enable IP whitelisting, grant READ.
# - TRADE permission is ONLY granted if/when live capital phase begins.
# ------------------------------------------------------------------------------

# Binance USD-M Futures (Live)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance USD-M Futures (Testnet / Sandbox)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Bybit v5 Derivatives (Live)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Bybit v5 Derivatives (Testnet / Sandbox)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Deribit (Live)
